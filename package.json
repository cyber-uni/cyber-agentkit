{
	"private": true,
	"type": "module",
	"scripts": {
		"build": "turbo build",
		"check": "biome check --write",
		"cs": "changeset",
		"dev": "pnpm --filter cyber-agentkit dev",
		"format": "biome format --write .",
		"prepare": "node -e \"if(!(process.env.CI||process.env.GITHUB_ACTIONS))require('child_process').execSync('husky',{stdio:'inherit'})\"",
		"release": "changeset publish",
		"test": "turbo test",
		"test:scripts": "node --test \"scripts/**/*.test.mjs\"",
		"typecheck": "turbo typecheck",
		"plugin:build": "universal-plugin plugin build --root packages/cyber-agentkit && biome format --write packages/cyber-agentkit",
		"plugin:check": "node scripts/skill-scripts-drift.mjs",
		"plugin:sync": "universal-plugin publish sync-version --root packages/cyber-agentkit && node packages/cyber-agentkit/scripts/sync-skill-pin.mjs && pnpm plugin:build",
		"up": "pnpm --filter ./packages/cyber-agentkit",
		"verify": "turbo verify",
		"version": "changeset version && pnpm plugin:sync",
		"web": "pnpm --filter web"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@changesets/cli": "^3.0.0",
		"@commitlint/cli": "^21.0.2",
		"@commitlint/config-conventional": "^21.0.2",
		"@repobuddy/biome": "^2.3.1",
		"husky": "^9.1.7",
		"turbo": "^2.9.16",
		"universal-plugin": "^0.20.0"
	},
	"packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
	"engines": {
		"node": ">=22"
	}
}
