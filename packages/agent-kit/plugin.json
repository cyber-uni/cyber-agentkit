{
	"$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
	"name": "uni-agent-kit",
	"version": "0.7.1",
	"description": "An agent-harness-agnostic toolkit: the fundamental features agent tools need, working the same on every harness. Detect the running harness, check plugin dependencies, resolve layered reference documents, and lease git worktrees.",
	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/spikyuni/uni-agent-kit",
	"repository": "https://github.com/spikyuni/uni-agent-kit",
	"license": "MIT",
	"keywords": ["agent-harness", "claude-code", "cursor", "codex", "copilot-cli"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"skills": "./skills/",
			"harnesses": {
				"claude-code": {},
				"cursor": {},
				"codex": {},
				"copilot-cli": {}
			},
			"scripts": {
				"skills/reference/scripts/reference.mjs": "src/references/reference.skill-script.ts"
			}
		}
	}
}
