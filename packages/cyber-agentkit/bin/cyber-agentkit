#!/bin/sh
# Generated by `universal-plugin plugin build` from plugin.json. Edit plugin.json, not this file.
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
entry="$root/bin/cyber-agentkit.mjs"
if [ ! -f "$entry" ]; then
  echo 'cyber-agentkit: bin/cyber-agentkit.mjs is missing. This copy of the plugin was not built.' >&2
  version=$(sed -n 's/^[[:space:]]*"version":[[:space:]]*"\([^"]*\)".*/\1/p' "$root/plugin.json" 2>/dev/null | head -n 1)
  echo "To run this version without a build: npx -y cyber-agentkit${version:+@$version} ..." >&2
  exit 127
fi
exec node "$entry" "$@"
