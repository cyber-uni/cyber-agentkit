	"author": {
		"name": "unional"
	},
	"homepage": "https://github.com/cyberuni/agent-harness",
	"repository": "https://github.com/cyberuni/agent-harness",
	"license": "MIT",
	"keywords": ["agent-harness", "claude-code", "cursor", "codex", "copilot-cli"],
	"extensions": {
		"org.cyberuni.universal-plugin": {
			"skills": "./skills/",
			"harnesses": {
				"claude-code": {},
				"cursor": {},
				"codex": {},
				"copilot-cli": {}
			},
			"scripts": {
				"skills/reference/scripts/reference.mjs": "src/references/reference.skill-script.ts"
			}
		}
